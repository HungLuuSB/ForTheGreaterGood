--!strict
-- Start fairness in mirror AI matches (S-162, next.md item 6): a longer run
-- than the slow suite's guard (Fairness.spec, 36 matches on Ridgeline), as
-- its own report. It runs only with the balance checkpoint.
--   lune run fairness [seeds] [minutes] [mapFilter] [level]
-- The same AI level on both starts (default normal), both faction mirrors
-- (Order vs Order, Chaos vs Chaos), seeds 1.. (default 12: 24 matches per
-- map), up to `minutes` of game time (default 10; then the value lead
-- decides, as in Fairness.spec), on every two-start map: Ridgeline,
-- Coastline, Normandy, The Canyon. Per map: wins by start, draws, and the
-- two-sided binomial p of a split at least that uneven. Target: no start
-- below a third of the decided matches on any map.
-- Writes docs/FAIRNESS.md (report only) when run without a map filter.
-- `--jobs=N` (default 6): N Lune processes in parallel (S-99).

local fs = require("@lune/fs")
local process = require("@lune/process")
local DateTime = require("@lune/datetime")
local Parallel = require("./parallel")

local Sim = require("../src/server/Sim/Sim")
local Skirmish = require("../src/server/Sim/AI/Skirmish")

local ARGS, FLAGS = Parallel.args(process.args)
local SEEDS = tonumber(ARGS[1]) or 12
local MINUTES = tonumber(ARGS[2]) or 10
local FILTER = if ARGS[3] == nil or ARGS[3] == "all" then nil else ARGS[3]
local LEVEL = ARGS[4] or "normal"
local MAPS = { "map:ridgeline", "map:coastline", "map:normandy", "map:canyon" }

type Item = { mapId: string, seed: number, mirror: string, teams: { number } }
local items: { Item } = {}
for _, mapId in MAPS do
	if FILTER and not string.find(mapId, FILTER, 1, true) then
		continue
	end
	for seed = 1, SEEDS do
		for _, m in { { "order", { 1, 3 } }, { "chaos", { 2, 4 } } } do -- teams: odd = Order, even = Chaos
			table.insert(items, { mapId = mapId, seed = seed, mirror = m[1] :: string, teams = m[2] :: { number } })
		end
	end
end

-- 1 or 2: the start that won (or led in value at the limit); 0: a draw.
local function play(item: Item): (number, number)
	local sim = Sim.new({
		seed = item.seed,
		players = { { id = 1, team = item.teams[1], allyTeam = 1 }, { id = 2, team = item.teams[2], allyTeam = 2 } },
		mapId = item.mapId,
		scenario = "standard_start",
		match = { mode = "FFA", win = "COMMAND_ENDS", ai = { [1] = LEVEL, [2] = LEVEL } },
	})
	local brains = Skirmish.forMatch(sim)
	for _ = 1, MINUTES * 60 * 15 do
		for _, b in brains do
			Skirmish.tick(b)
		end
		Sim.step(sim)
		if sim.match.over then
			break
		end
	end
	if sim.match.over then
		return sim.match.winner or 0, sim.tick
	end
	local v = { 0, 0 }
	for _, id in sim.world.ids do
		local a = sim.world.ally[id]
		if a == 1 or a == 2 then
			local c = sim.defs.unitByIndex[sim.world.defIndex[id]].cost
			v[a] += (c.supply + c.power / 10) * sim.world.buildProgress[id]
		end
	end
	return if v[1] > v[2] then 1 elseif v[2] > v[1] then 2 else 0, sim.tick
end

local worker, workers = Parallel.worker(FLAGS)
if worker then
	for i, item in items do
		if (i - 1) % workers == worker then
			local winner, tick = play(item)
			print(`RESULT {i} {winner} {tick}`)
		end
	end
	return
end

local t0 = DateTime.now().unixTimestampMillis
local results: { { winner: number, tick: number } } = {}
local jobs = tonumber(FLAGS.jobs) or 6
if jobs > 1 then
	for i, fields in Parallel.run("fairness", process.args, jobs) do
		results[i] = { winner = tonumber(fields[1]) :: number, tick = tonumber(fields[2]) :: number }
	end
else
	for i, item in items do
		local winner, tick = play(item)
		results[i] = { winner = winner, tick = tick }
	end
end

-- Two-sided exact binomial p (p = 0.5) of a split at least as uneven as k of n.
local function binomialP(k: number, n: number): number
	if n == 0 then
		return 1
	end
	local lo = math.min(k, n - k)
	local tail, c = 0, 1 -- c = C(n, i)
	for i = 0, lo do
		tail += c
		c = c * (n - i) / (i + 1)
	end
	return math.min(1, 2 * tail / 2 ^ n)
end

local lines: { string } = {}
local function out(s: string)
	print(s)
	table.insert(lines, s)
end

out("# Start fairness in mirror AI matches")
out("")
out(`Generated by \`lune run fairness {SEEDS} {MINUTES}\` (S-162) on {DateTime.now():formatUniversalTime("%Y-%m-%d")}: {LEVEL} AI against {LEVEL} AI of the same faction, seeds 1..{SEEDS}, both faction mirrors, up to {MINUTES} minutes (then the value lead decides). Report only; it runs with the balance checkpoint. Target: on every map neither start wins under a third of the decided matches.`)
out("")
out("| Map | Matches | Start 1 | Start 2 | Draws | Order mirror (1 / 2) | Chaos mirror (1 / 2) | p (two-sided) | In target |")
out("|---|---|---|---|---|---|---|---|---|")
local allOk = true
for _, mapId in MAPS do
	local n, s1, s2, draws = 0, 0, 0, 0
	local by = { order = { 0, 0 }, chaos = { 0, 0 } }
	for i, item in items do
		if item.mapId ~= mapId then
			continue
		end
		local r = results[i]
		assert(r, `no result for match {i}`)
		n += 1
		if r.winner == 1 then
			s1 += 1
			by[item.mirror][1] += 1
		elseif r.winner == 2 then
			s2 += 1
			by[item.mirror][2] += 1
		else
			draws += 1
		end
	end
	if n == 0 then
		continue
	end
	local decided = s1 + s2
	local ok = decided > 0 and math.min(s1, s2) * 3 >= decided
	allOk = allOk and ok
	out(`| {mapId} | {n} | {s1} | {s2} | {draws} | {by.order[1]} / {by.order[2]} | {by.chaos[1]} / {by.chaos[2]} | {string.format("%.2f", binomialP(s1, decided))} | {if ok then "yes" else "**no**"} |`)
end
out("")
out(`Overall: {if allOk then "every map in target" else "**a map is out of target**"}. {#items} matches in {math.floor((DateTime.now().unixTimestampMillis - t0) / 1000 + 0.5)} s.`)

if FILTER == nil then
	fs.writeFile("docs/FAIRNESS.md", table.concat(lines, "\n") .. "\n")
	print("written to docs/FAIRNESS.md")
end
