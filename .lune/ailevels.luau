--!strict
-- AI difficulty matchups (S-17): lune run ailevels [minutes] [filter] [seeds]
-- Plays the skirmish AI levels against each other under Command Ends, for
-- up to `minutes` of game time (default 40):
--   1v1 on map:ridgeline, map:coastline and skirmish:256: each pairing as
--   an Order mirror and a Chaos mirror, each with the sides swapped (the
--   factions are far apart in M8 balance: a mixed match measures the
--   faction, not the level);
--   2v2 on map:twin_lakes: each team one Order and one Chaos player;
--   4-player FFA on map:crossroads, levels rotated.
-- Every match is played with `seeds` seeds (default 3: 7, 8, 9).
-- Writes docs/AI_LEVELS.md (report only). `filter`: only maps whose ID
-- contains it ("all" for every map, when giving seeds).

local fs = require("@lune/fs")
local process = require("@lune/process")

local Sim = require("../src/server/Sim/Sim")
local Skirmish = require("../src/server/Sim/AI/Skirmish")

local MINUTES = tonumber(process.args[1]) or 40
local FILTER = if process.args[2] == "all" then nil else process.args[2]
local SEEDS = tonumber(process.args[3]) or 3
local TICKS = MINUTES * 60 * 15

-- players: { team, allyTeam } per start; odd teams play Order, even Chaos
-- (Scenarios.standard_start)
type Match = { mapId: string, levels: { string }, players: { { number } }, label: string }

local matches: { Match } = {}
local PAIRS = { { "hard", "normal" }, { "normal", "easy" }, { "hard", "easy" } }
local ORDER_MIRROR = { { 1, 1 }, { 3, 2 } }
local CHAOS_MIRROR = { { 2, 1 }, { 4, 2 } }
for _, mapId in { "map:ridgeline", "map:coastline", "skirmish:256" } do
	for _, pair in PAIRS do
		for _, f in { { ORDER_MIRROR, "Order" }, { CHAOS_MIRROR, "Chaos" } } do
			table.insert(matches, { mapId = mapId, levels = { pair[1], pair[2] }, players = f[1], label = `{pair[1]} vs {pair[2]} ({f[2]})` })
			table.insert(matches, { mapId = mapId, levels = { pair[2], pair[1] }, players = f[1], label = `{pair[2]} vs {pair[1]} ({f[2]})` })
		end
	end
end
-- 2v2: players 1-2 (west) against 3-4 (east), one Order and one Chaos each
local MIXED_TEAMS = { { 1, 1 }, { 2, 1 }, { 3, 2 }, { 4, 2 } }
for _, pair in { { "hard", "normal" }, { "normal", "easy" } } do
	table.insert(matches, { mapId = "map:twin_lakes", levels = { pair[1], pair[1], pair[2], pair[2] }, players = MIXED_TEAMS, label = `{pair[1]} ×2 vs {pair[2]} ×2` })
	table.insert(matches, { mapId = "map:twin_lakes", levels = { pair[2], pair[2], pair[1], pair[1] }, players = MIXED_TEAMS, label = `{pair[2]} ×2 vs {pair[1]} ×2` })
end
local FFA = { { 1, 1 }, { 2, 2 }, { 3, 3 }, { 4, 4 } }
table.insert(matches, { mapId = "map:crossroads", levels = { "hard", "normal", "easy", "normal" }, players = FFA, label = "FFA: hard, normal, easy, normal" })
table.insert(matches, { mapId = "map:crossroads", levels = { "normal", "easy", "normal", "hard" }, players = FFA, label = "FFA: normal, easy, normal, hard" })

local lines = {}
local function out(s: string)
	print(s)
	table.insert(lines, s)
end


local function value(sim: Sim.Sim, ally: number): number
	local w = sim.world
	local v = 0
	for _, id in w.ids do
		if w.ally[id] == ally then
			local c = sim.defs.unitByIndex[w.defIndex[id]].cost
			v += (c.supply + c.power / 10) * w.buildProgress[id]
		end
	end
	return v
end

out("# AI difficulty matchups")
out("")
out(`Generated by \`lune run ailevels {MINUTES} all {SEEDS}\` (S-17): skirmish AI levels against each other under Command Ends, up to {MINUTES} minutes of game time, seeds 7..{6 + SEEDS} for every line. Report only. A match still running at the limit shows the side with more unit value (supply + power / 10, frames by progress), marked "on value"; it is undecided and doesn't count as a win in the tally (S-32).`)
out("")
out("| Map | Players (in start order) | Seed | Winner | Length | Peak units |")
out("|---|---|---|---|---|---|")

local wins: { [string]: { [string]: number } } = {}
local undecided: { [string]: { [string]: number } } = {} -- called on value at the limit: leader → trailer
local mapWins: { [string]: { [string]: number } } = {} -- map → "a>b" → decided wins (S-57)
local ffaWins: { [string]: { [string]: number } } = {} -- map → winning level → FFA wins
local function tally(a: string, b: string, mapId: string)
	wins[a] = wins[a] or {}
	wins[a][b] = (wins[a][b] or 0) + 1
	mapWins[mapId] = mapWins[mapId] or {}
	mapWins[mapId][`{a}>{b}`] = (mapWins[mapId][`{a}>{b}`] or 0) + 1
end

local t0 = os.clock()
local lengths: { [string]: { number } } = {}
for _, m in matches do
	if FILTER and not string.find(m.mapId, FILTER, 1, true) then
		continue
	end
	for seed = 7, 6 + SEEDS do
	local n = #m.levels
	local teams = n == 4 and m.mapId == "map:twin_lakes"
	local ai = {}
	local players = {}
	for i, level in m.levels do
		ai[i] = level
		table.insert(players, { id = i, team = m.players[i][1], allyTeam = m.players[i][2] })
	end
	local sim = Sim.new({
		seed = seed,
		players = players,
		mapId = m.mapId,
		scenario = "standard_start",
		match = { mode = if teams then "TEAM" else "FFA", win = "COMMAND_ENDS", ai = ai },
	})
	local brains = Skirmish.forMatch(sim)
	local peak = 0
	for _ = 1, TICKS do
		for _, b in brains do
			Skirmish.tick(b)
		end
		Sim.step(sim)
		peak = math.max(peak, #sim.world.ids)
		if sim.match.over then
			break
		end
	end
	local winnerAlly, how = sim.match.winner, ""
	if not sim.match.over then
		local best, bestV = 0, -1
		for _, ally in sim.allyTeams do
			local v = value(sim, ally)
			if v > bestV then
				best, bestV = ally, v
			end
		end
		winnerAlly, how = best, " (on value)"
	end
	-- the winning level(s), and tallies of level against level
	local winLevels, loseLevels = {}, {}
	for i, level in m.levels do
		local ally = sim.players[i].allyTeam
		if ally == winnerAlly then
			table.insert(winLevels, level)
		else
			table.insert(loseLevels, level)
		end
	end
	local winner = if #winLevels > 0 then `{table.concat(winLevels, " + ")}{how}` else "nobody"
	-- a win counts only when the match was decided (Command Ends); a match
	-- called on value at the limit is undecided (S-32)
	if #winLevels > 0 and (n == 2 or teams) then
		if how == "" then
			tally(winLevels[1], loseLevels[1], m.mapId)
		else
			undecided[winLevels[1]] = undecided[winLevels[1]] or {}
			undecided[winLevels[1]][loseLevels[1]] = (undecided[winLevels[1]][loseLevels[1]] or 0) + 1
		end
	end
	if n == 4 and not teams and #winLevels > 0 and how == "" then
		ffaWins[m.mapId] = ffaWins[m.mapId] or {}
		ffaWins[m.mapId][winLevels[1]] = (ffaWins[m.mapId][winLevels[1]] or 0) + 1
	end
	out(string.format("| %s | %s | %d | %s | %.1f min | %d |", m.mapId, m.label, seed, winner, sim.tick / 900, peak))
	lengths[m.mapId] = lengths[m.mapId] or {}
	table.insert(lengths[m.mapId], sim.tick / 900)
	end
end
out("")
out("**Tally** (1v1 and 2v2: matches won by the row level against the column level; only matches decided by Command Ends count, those still running at the limit are in brackets as \"ahead on value\" and are not wins):")
out("")
out("| | easy | normal | hard |")
out("|---|---|---|---|")
for _, a in { "easy", "normal", "hard" } do
	local row = {}
	for _, b in { "easy", "normal", "hard" } do
		local u = (undecided[a] or {})[b] or 0
		table.insert(row, if a == b then "—" else tostring((wins[a] or {})[b] or 0) .. (if u > 0 then ` ({u})` else ""))
	end
	out(`| {a} | {table.concat(row, " | ")} |`)
end
out("")
out("**Per map** (S-57; decided matches, the row's level first: hard–normal means hard's wins – normal's wins; FFA: wins per level):")
out("")
out("| Map | hard–normal | normal–easy | hard–easy | FFA (hard / normal / easy) |")
out("|---|---|---|---|---|")
for _, mapId in { "map:ridgeline", "map:coastline", "skirmish:256", "map:twin_lakes", "map:crossroads" } do
	local mw = mapWins[mapId] or {}
	local function pair(a: string, b: string): string
		return `{mw[a .. ">" .. b] or 0}–{mw[b .. ">" .. a] or 0}`
	end
	local f = ffaWins[mapId]
	local ffa = if f then `{f.hard or 0} / {f.normal or 0} / {f.easy or 0}` else "—"
	local twoPlayer = mapId ~= "map:crossroads"
	out(`| {mapId} | {if twoPlayer then pair("hard", "normal") else "—"} | {if twoPlayer then pair("normal", "easy") else "—"} | {if twoPlayer then pair("hard", "easy") else "—"} | {ffa} |`)
end
out("")
out("**Match lengths** per map (minutes; matches stopped at the limit count as the limit):")
out("")
out("| Map | Matches | Shortest | Median | Longest | At the limit |")
out("|---|---|---|---|---|---|")
for _, mapId in { "map:ridgeline", "map:coastline", "skirmish:256", "map:twin_lakes", "map:crossroads" } do
	local l = lengths[mapId]
	if l then
		table.sort(l)
		local atLimit = 0
		for _, v in l do
			if v >= MINUTES then
				atLimit += 1
			end
		end
		out(string.format("| %s | %d | %.1f | %.1f | %.1f | %d |", mapId, #l, l[1], l[(#l + 1) // 2], l[#l], atLimit))
	end
end
out("")
out(string.format("Run time %.0f s on the dev PC.", os.clock() - t0))
if FILTER == nil then
	fs.writeFile("docs/AI_LEVELS.md", table.concat(lines, "\n") .. "\n")
	print("wrote docs/AI_LEVELS.md")
end
