--!strict
-- The models status table (docs/progress/models.md, between the status-table markers):
-- every unit def with its blockout (hand-made / generic), mesh status and wreck status,
-- from the def, blockout and mesh registries. Run from the project root:
--     lune run assets/models/tools/status_table.luau
local fs = require("@lune/fs")

local Defs = require("../../../src/shared/Defs/Defs")
local Blockouts = require("../../../src/shared/Defs/Blockouts/Registry")
local Meshes = require("../../../src/shared/Defs/Meshes/Registry")

local DOC = "docs/progress/models.md"
local BEGIN, END = "<!-- status-table:begin -->", "<!-- status-table:end -->"

local set = Defs.load()
local rows = {}
for _, d in set.unitByIndex do
	table.insert(rows, d)
end
local DOMAINS = { ground = 1, air = 2, naval = 3, structure = 4 }
table.sort(rows, function(a, b)
	if (a.tier or 0) ~= (b.tier or 0) then
		return (a.tier or 0) < (b.tier or 0)
	end
	local da, db = DOMAINS[a.domain] or 9, DOMAINS[b.domain] or 9
	if da ~= db then
		return da < db
	end
	return a.id < b.id
end)

local lines = { "| Def | Name | Tier | Domain | Blockout | Mesh | Wreck |", "|---|---|---|---|---|---|---|" }
local n = { handmade = 0, mesh = 0, approved = 0, wreck = 0, wreckApproved = 0 }
for _, d in rows do
	local m = (Meshes :: any).units[d.model or d.id] or (Meshes :: any).units[d.id]
	local hand = (Blockouts :: any)[d.id] ~= nil
	n.handmade += if hand then 1 else 0
	n.mesh += if m then 1 else 0
	n.approved += if m and m.status == "approved" then 1 else 0
	n.wreck += if m and m.wreck then 1 else 0
	n.wreckApproved += if m and m.wreck and m.wreck.status == "approved" then 1 else 0
	table.insert(lines, `| \`{d.id}\` | {d.name} | {d.tier or "–"} | {d.domain} | {if hand then "hand-made" else "generic"} | {if m then m.status else "–"} | {if m and m.wreck then m.wreck.status else "–"} |`)
end
local summary = `{#rows} defs: {n.handmade} hand-made blockouts; {n.mesh} meshes ({n.approved} approved, {n.mesh - n.approved} in review); {n.wreck} wrecks ({n.wreckApproved} approved). Generated by \`lune run assets/models/tools/status_table.luau\`.`

local doc = fs.readFile(DOC)
local a, b = string.find(doc, BEGIN, 1, true)
local c, e = string.find(doc, END, 1, true)
assert(a and c and c > b, "status-table markers missing in " .. DOC)
local body = BEGIN .. "\n" .. summary .. "\n\n" .. table.concat(lines, "\n") .. "\n" .. END
fs.writeFile(DOC, string.sub(doc, 1, a - 1) .. body .. string.sub(doc, e + 1))
print(summary)
