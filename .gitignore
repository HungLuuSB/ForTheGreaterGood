# Roblox place files: publish the place to Roblox (it keeps version history)
# and keep local backups outside this repo
*.rbxl
*.rbxlx
*.rbxl.lock
*.rbxlx.lock

# Rojo / tooling output
sourcemap.json
/build/

# OS and editor clutter
.DS_Store
Thumbs.db

# Debug output (images, logs) from Lune scripts
/debug_out/

# Blender preview renders (rebuilt by each unit's build.py)
/assets/models/*/export/preview_*.png
/assets/models/*/export_wreck/preview_*.png
/assets/models/*/export_wreck/*.fbm/
__pycache__/
/assets/models/*/export/*.fbm/
/assets/fx/*/export/preview_*.png
/assets/fx/*/*/export/preview_*.png
/assets/fx/*/*/export/*.fbm/
/assets/fx/*/export/*.fbm/

# Reference screenshots (style reference only, never committed)
/assets/reference/**/*.png
/assets/reference/**/*.jpg
/assets/reference/**/*.jpeg
/assets/reference/**/*.webp
/assets/reference/**/*.gif
/assets/reference/**/*.mp4
/assets/reference/**/*.html

# Node packages for tools/icons
node_modules/

# Baked map ground (C-167): the FBX parts and previews are rebuilt by
# assets/maps/tools/ground.py from the committed ground.json; the uploads'
# IDs are in assets/maps/<name>/roblox_assets.json
/assets/maps/*/export/*.fbx
/assets/maps/*/export/preview_*.png
/assets/maps/materials/*/preview_tile.png

# BAR reference (CC BY-NC-ND pictures; look only, never committed)
assets/reference/
