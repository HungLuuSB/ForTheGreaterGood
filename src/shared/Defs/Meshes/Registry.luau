--!strict
-- Mesh manifest (M-23, docs/contracts/rig.md section 7): every BAR-style mesh
-- by unit def ID, with its asset IDs, rig, team pieces and glow parts.
-- GENERATED by assets/models/tools/manifest.py from each mesh's rig.json and
-- roblox_assets.json; don't edit by hand. Owner: models stream.

export type Vec3 = { number }
export type Piece = { mesh: string, center: Vec3, size: Vec3, parent: string?, pivot: Vec3? }
export type Glow = {
	name: string,
	piece: string,
	channel: string,
	tint: Vec3,
	strength: number,
	center: Vec3,
	size: Vec3,
	mesh: string,
}
export type Entry = {
	status: string,
	model: string,
	pieces: { [string]: Piece },
	attachments: { [string]: { parent: string, at: Vec3 } },
	teamPieces: { string },
	maps: { [string]: string },
	glow: { Glow },
	glowShare: number,
	triangles: number,
	note: string?,
	visualPieces: { string }?, -- animated sub-pieces (M-27)
	anim: { [string]: { motion: string, axis: Vec3, range: number? } }?,
	wreck: any?, -- the wreck version (M-24)
}
-- the beam towers' shot (M-29, fx.md "Beam shot"): white textures and the
-- recommended values per faction ("order" / "chaos"; colors are RGB 0-255)
export type BeamShot = {
	status: string,
	note: string?,
	textures: { [string]: string },
	factions: { [string]: { [string]: any } },
}
-- the honeycomb shell over the shield dome (M-30, fx.md "Honeycomb shell"):
-- bands from the top cap down, each with its recommended opacity; center and
-- size at dome radius 1 (multiply by the dome's radius)
export type ShieldShell = {
	status: string,
	note: string?,
	texture: string,
	radius: number,
	refRadius: number,
	hex: number,
	bands: { { name: string, mesh: string, opacity: number, theta: { number }, center: Vec3, size: Vec3 } },
}

-- the shield's dome waves (fx.md "Dome waves"): bands of the dome, centres
-- evenly spaced from the top (0 degrees) to the rim (90), each spanning two
-- spacings; centre and size at dome radius 1. A wave between two centres
-- shows both bands weighted (1 - f, f).
export type ShieldWave = {
	status: string,
	note: string?,
	texture: string,
	radius: number,
	width: number,
	waves: number,
	seconds: number,
	opacity: number,
	bands: { { name: string, mesh: string, centre: number, theta: { number }, center: Vec3, size: Vec3 } },
}
-- the shield's energy column (fx.md "Energy column"): three Beams from the
-- generator's `beam` attachment to the dome's top; widths and texture
-- lengths are fractions of the dome radius
export type ColumnLayer = {
	texture: string,
	width0: number,
	width1: number,
	textureSpeed: number,
	textureLength: number,
	lightEmission: number,
	brightness: number,
	transparency: number,
}
export type ShieldColumn = {
	status: string,
	note: string?,
	core: ColumnLayer,
	swirl: ColumnLayer,
	glow: ColumnLayer,
	weakest: number,
	deploy: { shoot: number, thicken: number },
	collapse: { pinch: number, flash: number },
}
-- key art with parallax layers (lobby contract key-art.md, L-13): layers back
-- to front, each cut into tiles (columns, rows) listed row by row from the top left
export type KeyArt = {
	status: string,
	title: string,
	size: { number },
	tiles: { number },
	layers: { { name: string, depth: number, images: { string } } },
}

