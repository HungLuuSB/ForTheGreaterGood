-- A def's picture: its sheet's image and top-left pixel, or nil (no picture,
-- or its sheet isn't uploaded yet).
function UnitPictures.of(defId: string): (string?, number, number)
	local u = UnitPictures.units[defId]
	local image = u and UnitPictures.sheets[u[1]]
	if u == nil or image == nil or image == "" then
		return nil, 0, 0
	end
	return image, u[2], u[3]
end

return UnitPictures
